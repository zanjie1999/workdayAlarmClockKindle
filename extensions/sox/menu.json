{
"comment001": "工作咩闹钟 on Kindle",
"comment002": "兼sox本地音乐播放器",
"items": [
{
"name": "工作咩闹钟",
"priority": -1,
"items": [
{"name": "显示IP", "priority": 1, "exitmenu": false, "checked": true, "action": "eips 7 1 \"IP: `ifconfig wlan0 | grep 'inet addr' | awk -F '[ :]' '{print $13}'`\""},
{"name": "启动服务", "priority": 2, "exitmenu": false, "checked": true, "action": "./start.sh"},
{"name": "停止服务", "priority": 3, "exitmenu": false, "checked": true, "action": "./stop.sh"},
{"name": "上一首", "priority": 4, "exitmenu": false, "checked": true, "action": "curl http://127.0.0.1:8080/prev"},
{"name": "下一首", "priority": 5, "exitmenu": false, "checked": true, "action": "curl http://127.0.0.1:8080/next"},
{"name": "播放暂停", "priority": 6, "exitmenu": false, "checked": true, "action": "curl http://127.0.0.1:8080/play"},
{"name": "停止", "priority": 7, "exitmenu": false, "checked": true, "action": "curl http://127.0.0.1:8080/stop"},
{"name": "播放music目录", "priority": 8, "exitmenu": false, "checked": true, "action": "find /mnt/us/music -type f -exec /mnt/us/extensions/sox/play.sh {} \\;"},
{"name": "下一首", "priority": 9, "exitmenu": false, "checked": true, "action": "pkill -9 gst-launch && pkill -9 sox"},
{"name": "暂停", "priority": 10, "exitmenu": false, "checked": true, "action": "pkill -STOP gst-launch"},
{"name": "恢复播放", "priority": 11, "exitmenu": false, "checked": true, "action": "pkill -CONT gst-launch"},
{"name": "停止播放", "priority": 12, "exitmenu": false, "checked": true, "action": "./stopPlay.sh"},
{"name": "关防火墙", "priority": 13, "exitmenu": false, "checked": true, "action": "iptables -I INPUT -j ACCEPT"},
{"name": "开防火墙", "priority": 14, "exitmenu": false, "checked": true, "action": "iptables-restore; /etc/sysconfig/iptables && iptables -I INPUT -p tcp --dport 22 -j ACCEPT"}
]}]}
